<mvc:View
    controllerName="code.zfqg2sd0004.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

    <Page id="page" title="월별 구독 KPI 대시보드">
        <content>
            <FlexBox id="mainBox"
                     renderType="Bare"
                     direction="Column"
                     class="sapUiSmallMargin"
                     width="calc(100% - 2rem)">
                <items>

                    <!-- 검색 필터 -->
                    <Panel id="filterPanel" headerText="검색 조건" expandable="true" expanded="true" width="100%">
                        <content>
                            <FlexBox id="filterBox" renderType="Bare" wrap="Wrap">
                                <items>
                                    <FlexBox id="fb1" direction="Column" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <items>
                                            <Input id="inputOrdymFrom" placeholder="YYYYMM(From)" width="130px"/>
                                        </items>
                                    </FlexBox>
                                    <FlexBox id="fb2" direction="Column" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <items>
                                            <Input id="inputOrdymTo" placeholder="YYYYMM(To)" width="130px"/>
                                        </items>
                                    </FlexBox>
                                    <FlexBox id="fb3" direction="Column" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <items>
                                            <Input id="inputCustid" placeholder="고객 ID" width="160px"
                                                   showValueHelp="true"
                                                   valueHelpRequest="onCustidValueHelp"/>
                                        </items>
                                    </FlexBox>
                                    <FlexBox id="fb4" direction="Column" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                        <items>
                                            <Select id="selectOrdsts" width="120px">
                                                <items>
                                                    <core:Item id="itmAll" key=""  text="전체"/>
                                                    <core:Item id="itm1"   key="1" text="대기"/>
                                                    <core:Item id="itm2"   key="2" text="승인"/>
                                                </items>
                                            </Select>
                                        </items>
                                    </FlexBox>
                                </items>
                            </FlexBox>
                            <Toolbar id="searchToolbar">
                                <ToolbarSpacer id="ts0"/>
                                <Button id="btnCompare"
                                        text="{= ${viewModel>/compareMode} ? '올해만 보기' : '전년동기 비교'}"
                                        icon="{= ${viewModel>/compareMode} ? 'sap-icon://undo' : 'sap-icon://compare'}"
                                        press="onCompare"
                                        enabled="{viewModel>/compareEnabled}"/>
                                <Button id="btnSearch" text="조회" icon="sap-icon://search" type="Emphasized" press="onSearch"/>
                                <Button id="btnReset"  text="초기화" icon="sap-icon://clear-filter" press="onReset"/>
                            </Toolbar>
                        </content>
                    </Panel>

                    <!-- KPI 카드 + 차트 + 오더 테이블 세로 배치 -->
                    <FlexBox id="contentBox" renderType="Bare" direction="Column" width="100%" class="sapUiSmallMarginTop">
                        <items>

                            <!-- KPI 카드 4개 가로 정렬 -->
                            <HBox id="kpiBox" width="100%" renderType="Bare" class="kpiCardRoot sapUiSmallMarginBottom">
                                <items>

                                    <VBox id="kpiGrowthBox" class="kpiCardBox" visible="{viewModel>/compareVisible}">
                                        <items>
                                            <HBox id="kpiGrowthHeader" justifyContent="SpaceBetween" alignItems="Start">
                                                <items>
                                                    <VBox id="kpiGrowthLabelBox">
                                                        <items>
                                                            <Text id="kpiGrowthLabel1" text="전년동기 대비" class="kpiCardLabel"/>
                                                            <Text id="kpiGrowthLabel2" text="매출 증감률"   class="kpiCardLabel"/>
                                                        </items>
                                                    </VBox>
                                                    <core:Icon id="kpiGrowthIconUp"
                                                               src="sap-icon://trend-up"
                                                               class="kpiCardIcon kpiIconGood"
                                                               visible="{= ${viewModel>/kpiGrowth} >= 0}"/>
                                                    <core:Icon id="kpiGrowthIconDown"
                                                               src="sap-icon://trend-down"
                                                               class="kpiCardIcon kpiIconCritical"
                                                               visible="{= ${viewModel>/kpiGrowth} &lt; 0}"/>
                                                </items>
                                            </HBox>
                                            <HBox id="kpiGrowthValueBox" alignItems="Baseline">
                                                <items>
                                                    <Text id="kpiGrowthValueGood"
                                                          text="{viewModel>/kpiGrowth}"
                                                          class="kpiCardValue kpiValueGood"
                                                          visible="{= ${viewModel>/kpiGrowth} >= 0}"/>
                                                    <Text id="kpiGrowthValueBad"
                                                          text="{viewModel>/kpiGrowth}"
                                                          class="kpiCardValue kpiValueCritical"
                                                          visible="{= ${viewModel>/kpiGrowth} &lt; 0}"/>
                                                    <Text id="kpiGrowthUnit" text="%" class="kpiCardUnit"/>
                                                </items>
                                            </HBox>
                                        </items>
                                    </VBox>

                                    <VBox id="kpiTotamtBox" class="kpiCardBox">
                                        <items>
                                            <HBox id="kpiTotamtHeader" justifyContent="SpaceBetween" alignItems="Start">
                                                <items>
                                                    <VBox id="kpiTotamtLabelBox">
                                                        <items>
                                                            <Text id="kpiTotamtLabel1" text="월별 총매출"    class="kpiCardLabel"/>
                                                            <Text id="kpiTotamtLabel2" text="조회 기간 합계" class="kpiCardLabel"/>
                                                        </items>
                                                    </VBox>
                                                    <core:Icon id="kpiTotamtIcon" src="sap-icon://money-bills" class="kpiCardIcon kpiIconGood"/>
                                                </items>
                                            </HBox>
                                            <HBox id="kpiTotamtValueBox" alignItems="Baseline">
                                                <items>
                                                    <Text id="kpiTotamtValue" text="{viewModel>/kpiTotamt}" class="kpiCardValue kpiValueGood"/>
                                                    <Text id="kpiTotamtUnit"  text="KRW" class="kpiCardUnit"/>
                                                </items>
                                            </HBox>
                                        </items>
                                    </VBox>

                                    <VBox id="kpiOrdCntBox" class="kpiCardBox">
                                        <items>
                                            <HBox id="kpiOrdCntHeader" justifyContent="SpaceBetween" alignItems="Start">
                                                <items>
                                                    <VBox id="kpiOrdCntLabelBox">
                                                        <items>
                                                            <Text id="kpiOrdCntLabel1" text="구독건수"       class="kpiCardLabel"/>
                                                            <Text id="kpiOrdCntLabel2" text="전체 오더 건수"  class="kpiCardLabel"/>
                                                        </items>
                                                    </VBox>
                                                    <core:Icon id="kpiOrdCntIcon" src="sap-icon://document" class="kpiCardIcon kpiIconNeutral"/>
                                                </items>
                                            </HBox>
                                            <HBox id="kpiOrdCntValueBox" alignItems="Baseline">
                                                <items>
                                                    <Text id="kpiOrdCntValue" text="{viewModel>/kpiOrdCnt}" class="kpiCardValue"/>
                                                    <Text id="kpiOrdCntUnit"  text="건" class="kpiCardUnit"/>
                                                </items>
                                            </HBox>
                                        </items>
                                    </VBox>

                                    <VBox id="kpiApvCntBox" class="kpiCardBox">
                                        <items>
                                            <HBox id="kpiApvCntHeader" justifyContent="SpaceBetween" alignItems="Start">
                                                <items>
                                                    <VBox id="kpiApvCntLabelBox">
                                                        <items>
                                                            <Text id="kpiApvCntLabel1" text="승인건수"           class="kpiCardLabel"/>
                                                            <Text id="kpiApvCntLabel2" text="승인 완료 오더 건수"  class="kpiCardLabel"/>
                                                        </items>
                                                    </VBox>
                                                    <core:Icon id="kpiApvCntIcon" src="sap-icon://accept" class="kpiCardIcon kpiIconWarning"/>
                                                </items>
                                            </HBox>
                                            <HBox id="kpiApvCntValueBox" alignItems="Baseline">
                                                <items>
                                                    <Text id="kpiApvCntValue" text="{viewModel>/kpiApvCnt}" class="kpiCardValue kpiValueWarning"/>
                                                    <Text id="kpiApvCntUnit"  text="건" class="kpiCardUnit"/>
                                                </items>
                                            </HBox>
                                        </items>
                                    </VBox>

                                </items>
                            </HBox>

                            <!-- 차트: 월별 매출 추이 -->
                            <Panel id="chartPanel" headerText="월별 매출 추이" width="100%">
                                <content>
                                    <viz:VizFrame id="vizChart"
                                                  vizType="column"
                                                  width="100%"
                                                  height="300px"
                                                  uiConfig="{applicationSet:'fiori'}">
                                        <viz:dataset>
                                            <vizData:FlattenedDataset id="ds1"
                                                data="{viewModel>/chartData}">
                                                <vizData:dimensions>
                                                    <vizData:DimensionDefinition id="dim1" name="월" value="{viewModel>month}"/>
                                                    <vizData:DimensionDefinition id="dim2" name="연도" value="{viewModel>series}"/>
                                                </vizData:dimensions>
                                                <vizData:measures>
                                                    <vizData:MeasureDefinition id="msr1" name="매출" value="{viewModel>amount}"/>
                                                </vizData:measures>
                                            </vizData:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <vizFeeds:FeedItem id="feed1" uid="categoryAxis" type="Dimension" values="월"/>
                                            <vizFeeds:FeedItem id="feed2" uid="valueAxis"    type="Measure"   values="매출"/>
                                            <vizFeeds:FeedItem id="feed3" uid="color"        type="Dimension" values="연도"/>
                                        </viz:feeds>
                                    </viz:VizFrame>
                                    <viz:Popover id="popover"/>
                                </content>
                            </Panel>

                            <!-- 오더 목록 테이블 -->
                            <Panel id="orderPanel" headerText="오더 목록" class="sapUiSmallMarginTop" width="100%">
                                <content>
                                    <ScrollContainer id="scrollOrder" height="300px" vertical="true" width="100%">
                                        <Table id="orderTable"
                                               items="{viewModel>/orderItems}"
                                               sticky="HeaderToolbar,ColumnHeaders"
                                               growing="true"
                                               growingThreshold="20"
                                               growingScrollToLoad="true">
                                            <headerToolbar>
                                                <OverflowToolbar id="oft1">
                                                    <Title id="t1" text="{= '오더 목록 (' + ${viewModel>/orderCount} + '건)'}" level="H3"/>
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column id="colOrdno"  width="10em"><Text id="tc1" text="오더 번호"/></Column>
                                                <Column id="colOrdym"  width="7em" ><Text id="tc2" text="오더 월"/></Column>
                                                <Column id="colCustid" width="8em" ><Text id="tc3" text="고객 ID"/></Column>
                                                <Column id="colCustnm" width="15em"><Text id="tc4" text="고객명"/></Column>
                                                <Column id="colOrdseq" width="5em" ><Text id="tc5" text="회차"/></Column>
                                                <Column id="colOrdsts" width="7em" ><Text id="tc6" text="승인상태"/></Column>
                                                <Column id="colTotamt" width="10em"><Text id="tc7" text="총 금액"/></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem id="cli1">
                                                    <cells>
                                                        <Text id="txtOrdno"  text="{viewModel>ordno}"/>
                                                        <Text id="txtOrdym"  text="{viewModel>ordym}"/>
                                                        <Text id="txtCustid" text="{viewModel>custid}"/>
                                                        <Text id="txtCustnm" text="{viewModel>custnm}"/>
                                                        <Text id="txtOrdseq" text="{viewModel>ordseq}"/>
                                                        <ObjectStatus id="objOrdsts"
                                                            text="{= ${viewModel>ordsts} === '1' ? '대기' : '승인'}"
                                                            state="{= ${viewModel>ordsts} === '1' ? 'Warning' : 'Success'}"/>
                                                        <ObjectNumber id="txtTotamt"
                                                                      number="{path: 'viewModel>totamt', formatter: '.formatAmount'}"
                                                                      unit="{viewModel>currency}"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </ScrollContainer>
                                </content>
                            </Panel>

                        </items>
                    </FlexBox>

                </items>
            </FlexBox>
        </content>
    </Page>
</mvc:View>